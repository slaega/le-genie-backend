// Le Génie — PostgreSQL schema
// Usage: DATABASE_PROVIDER=postgres
// Migrate : yarn db:migrate:dev
// Generate: yarn db:generate
// Studio  : yarn db:studio

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

// Prisma 7 : url gérée dans prisma.config.ts, pas dans le schéma
datasource db {
  provider = "postgresql"
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  avatarPath       String?
  coverPath        String?
  professionalRole String?
  bio              String?
  about            String?
  website          String?
  twitterHandle    String?
  githubHandle     String?
  location         String?
  role             UserRole  @default(USER)
  suspended        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  contributors  Contributor[]
  comments      Comment[]
  refreshTokens RefreshToken[]
  authProviders AuthProvider[]
  postReaders   PostReader[]
  invitations   Invitation[]
  likes         Like[]
  following      Follow[]       @relation("Follower")
  followers      Follow[]       @relation("Author")
  notifications  Notification[]

  @@index([email])
  @@map("users")
}

model Post {
  id          String     @id @default(cuid())
  slug        String?    @unique
  title       String
  /// TipTap JSON — generateHTML() renders it server-side for SEO
  content     String     @default("{}") @db.Text
  imagePath   String?
  status      PostStatus @default(EMPTY)
  scheduledAt DateTime?
  publishedAt DateTime?
  readingTime Int?       @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  contributors Contributor[]
  comments     Comment[]
  invitations  Invitation[]
  postReaders  PostReader[]
  postTags     PostTag[]
  likes        Like[]

  @@index([status, createdAt])
  @@index([scheduledAt, status])
  @@map("posts")
}

model PostReader {
  id        String   @id @default(cuid())
  postId    String
  readerId  String
  ip        String?
  userAgent String?
  userId    String?
  viewedAt  DateTime @default(now())

  post Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@unique([postId, readerId])
  @@index([postId, readerId])
  @@index([userId, postId])
  @@map("post_readers")
}

model Contributor {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  owner     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId, userId])
  @@map("contributors")
}

model Comment {
  id         String    @id @default(cuid())
  content    String    @db.Text
  refactorAt DateTime?
  postId     String
  userId     String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("comments")
}

model AuthProvider {
  id             String    @id @default(cuid())
  userId         String
  provider       Provider
  providerUserId String
  activatedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId, provider])
  @@map("auth_providers")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId, token])
  @@map("refresh_tokens")
}

model Invitation {
  id        String   @id @default(cuid())
  content   String?  @db.Text
  email     String
  postId    String
  token     String   @unique
  expiredAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [email], references: [email])
  post Post  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, email])
  @@index([postId, email])
  @@index([token])
  @@map("invitations")
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  posts PostTag[]

  @@map("tags")
}

model PostTag {
  id     String @id @default(cuid())
  postId String
  name   String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [name], references: [name])

  @@unique([postId, name])
  @@index([postId, name])
  @@map("post_tags")
}

/// "Like" anonyme : identifié par fingerprint (hash IP+userAgent ou cookie).
/// Si l'utilisateur est connecté, userId est rempli en plus.
/// Toggle implémenté côté repo via upsert/delete sur la clé unique (postId, fingerprint).
model Like {
  id          String   @id @default(cuid())
  postId      String
  fingerprint String
  ip          String?
  userAgent   String?
  userId      String?
  createdAt   DateTime @default(now())

  post Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([postId, fingerprint])
  @@index([postId])
  @@index([postId, fingerprint])
  @@map("likes")
}

/// Abonné à la newsletter globale du blog (anonyme ou non).
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("subscribers")
}

/// Un utilisateur suit un auteur — notifications à chaque nouvelle publication.
model Follow {
  id         String   @id @default(cuid())
  followerId String
  authorId   String
  createdAt  DateTime @default(now())

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  author   User @relation("Author",   fields: [authorId],   references: [id], onDelete: Cascade)

  @@unique([followerId, authorId])
  @@index([authorId])
  @@map("follows")
}

/// Notification in-app pour un utilisateur (ex: nouvel article d'un auteur suivi).
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  postId    String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String   // bcrypt hash du code à 6 chiffres
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Provider {
  GOOGLE
  GITHUB
  MICROSOFT
}

enum PostStatus {
  EMPTY
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  NEW_POST
  NEW_FOLLOWER
  NEW_COMMENT
}

enum UserRole {
  USER
  ADMIN
}
