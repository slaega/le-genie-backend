// Le Génie — MySQL schema
// Usage: DATABASE_PROVIDER=mysql
// Migrate : yarn db:migrate:dev
// Push    : yarn db:push  (dev sans migration history)
// Generate: yarn db:generate
// Studio  : yarn db:studio
//
// Notes MySQL :
//   - TEXT/LONGTEXT ne supportent pas @default() côté DB
//     → content est initialisé par le service, pas par le schéma
//   - Les champs @unique indexés utilisent @db.VarChar pour rester
//     dans la limite de 3072 bytes (innodb_large_prefix)

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

// Prisma 7 : url et shadowDatabaseUrl gérées dans prisma.config.ts
datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  email            String    @unique @db.VarChar(320)
  name             String    @db.VarChar(255)
  avatarPath       String?   @db.VarChar(2048)
  coverPath        String?   @db.VarChar(2048)
  professionalRole String?   @db.VarChar(255)
  role             UserRole  @default(USER)
  suspended        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  contributors  Contributor[]
  comments      Comment[]
  refreshTokens RefreshToken[]
  authProviders AuthProvider[]
  postReaders   PostReader[]
  invitations   Invitation[]
  likes         Like[]
  following      Follow[]       @relation("Follower")
  followers      Follow[]       @relation("Author")
  notifications  Notification[]

  @@index([email])
  @@map("users")
}

model Post {
  id          String     @id @default(cuid())
  title       String     @db.VarChar(512)
  /// TipTap JSON — pas de DEFAULT DB côté MySQL (restriction TEXT)
  /// Toujours initialisé côté service avant insertion
  content     String     @db.LongText
  imagePath   String?    @db.VarChar(2048)
  status      PostStatus @default(EMPTY)
  scheduledAt DateTime?
  publishedAt DateTime?
  readingTime Int?       @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  contributors Contributor[]
  comments     Comment[]
  invitations  Invitation[]
  postReaders  PostReader[]
  postTags     PostTag[]
  likes        Like[]

  @@index([status, createdAt])
  @@index([scheduledAt, status])
  @@map("posts")
}

model PostReader {
  id        String   @id @default(cuid())
  postId    String
  readerId  String   @db.VarChar(255)
  ip        String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(512)
  userId    String?
  viewedAt  DateTime @default(now())

  post Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@unique([postId, readerId])
  @@index([postId, readerId])
  @@index([userId, postId])
  @@map("post_readers")
}

model Contributor {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  owner     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId, userId])
  @@map("contributors")
}

model Comment {
  id         String    @id @default(cuid())
  content    String    @db.Text
  refactorAt DateTime?
  postId     String
  userId     String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("comments")
}

model AuthProvider {
  id             String    @id @default(cuid())
  userId         String
  provider       Provider
  providerUserId String    @db.VarChar(255)
  activatedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId, provider])
  @@map("auth_providers")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  /// JWT — VarChar(512) pour rester indexable (@unique)
  token     String   @db.VarChar(512)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId, token])
  @@map("refresh_tokens")
}

model Invitation {
  id        String   @id @default(cuid())
  content   String?  @db.Text
  email     String   @db.VarChar(320)
  postId    String
  token     String   @unique @db.VarChar(512)
  expiredAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [email], references: [email])
  post Post  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, email])
  @@index([postId, email])
  @@index([token])
  @@map("invitations")
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique @db.VarChar(255)
  posts PostTag[]

  @@map("tags")
}

model PostTag {
  id     String @id @default(cuid())
  postId String
  name   String @db.VarChar(255)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [name], references: [name])

  @@unique([postId, name])
  @@index([postId, name])
  @@map("post_tags")
}

/// "Like" anonyme : identifié par fingerprint (hash IP+userAgent ou cookie).
/// Si l'utilisateur est connecté, userId est rempli en plus.
model Like {
  id          String   @id @default(cuid())
  postId      String
  fingerprint String   @db.VarChar(255)
  ip          String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(512)
  userId      String?
  createdAt   DateTime @default(now())

  post Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([postId, fingerprint])
  @@index([postId])
  @@index([postId, fingerprint])
  @@index([userId])
  @@map("likes")
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(320)
  createdAt DateTime @default(now())

  @@map("subscribers")
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  authorId   String
  createdAt  DateTime @default(now())

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  author   User @relation("Author",   fields: [authorId],   references: [id], onDelete: Cascade)

  @@unique([followerId, authorId])
  @@index([followerId])
  @@index([authorId])
  @@map("follows")
}

/// Notification in-app pour un utilisateur (ex: nouvel article d'un auteur suivi).
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String           @db.VarChar(255)
  body      String?          @db.VarChar(512)
  postId    String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read, createdAt])
  @@map("notifications")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Provider {
  GOOGLE
  GITHUB
  MICROSOFT
}

enum PostStatus {
  EMPTY
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  NEW_POST
  NEW_FOLLOWER
  NEW_COMMENT
}

enum UserRole {
  USER
  ADMIN
}
