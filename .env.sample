# ── App ──────────────────────────────────────────────────────────────────────
PORT=3030
API_PREFIX=api
APP_FALLBACK_LANGUAGE=fr
APP_THROTTLER_TTL=60
APP_THROTTLER_LIMIT=100

# ── Database ─────────────────────────────────────────────────────────────────
# DATABASE_PROVIDER: postgresql | mysql | sqlite
DATABASE_PROVIDER=postgresql
DATABASE_URL="postgresql://user:password@localhost:5432/le_genie"

# SQLite (dev/local):
# DATABASE_PROVIDER=sqlite
# DATABASE_URL="file:./dev.db"

# MySQL:
# DATABASE_PROVIDER=mysql
# DATABASE_URL="mysql://user:password@localhost:3306/le_genie"

# ── Auth ─────────────────────────────────────────────────────────────────────
AUTH_ACCESS_TOKEN_JWT_SECRET=change-me-access
AUTH_ACCESS_TOKEN_JWT_EXPIRES_IN=15m
AUTH_REFRESH_TOKEN_JWT_SECRET=change-me-refresh
AUTH_REFRESH_TOKEN_JWT_EXPIRES_IN=7d

# OAuth — Google
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# OAuth — GitHub
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# ── Storage ──────────────────────────────────────────────────────────────────
# STORAGE_DRIVER: local | minio | r2 | s3
STORAGE_DRIVER=local
STORAGE_UPLOAD_DIR=./uploads

# MinIO (self-hosted S3-compatible):
# STORAGE_DRIVER=minio
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_BUCKET=le-genie
# STORAGE_ACCESS_ID=minioadmin
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_PUBLIC_URL=http://localhost:9000/le-genie

# Cloudflare R2:
# STORAGE_DRIVER=r2
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_BUCKET=le-genie
# STORAGE_ACCESS_ID=<r2-access-key-id>
# STORAGE_ACCESS_KEY=<r2-secret-access-key>
# STORAGE_PUBLIC_URL=https://pub-<hash>.r2.dev  # or your custom domain

# AWS S3:
# STORAGE_DRIVER=s3
# STORAGE_REGION=eu-west-1
# STORAGE_BUCKET=le-genie
# STORAGE_ACCESS_ID=<aws-access-key>
# STORAGE_ACCESS_KEY=<aws-secret-key>
