# ── App ──────────────────────────────────────────────────────────────────────
PORT=3030
API_PREFIX=api
APP_FALLBACK_LANGUAGE=fr
APP_THROTTLER_TTL=60
APP_THROTTLER_LIMIT=100
FRONTEND_DOMAIN=http://localhost:3000

# Origines autorisées (virgule-séparé, sans espace)
CORS_ORIGINS=http://localhost:3000

# ── Base de données ───────────────────────────────────────────────────────────
# Option 1 — SQLite (zéro config, idéal pour démarrer vite)
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# Option 2 — PostgreSQL via docker-compose.dev.yml (make services)
# DATABASE_PROVIDER=postgres
# DATABASE_URL="postgresql://genie:genie@localhost:5432/genie_dev"

# Option 3 — MySQL
# DATABASE_PROVIDER=mysql
# DATABASE_URL="mysql://user:password@localhost:3306/le_genie"

# ── Auth JWT ──────────────────────────────────────────────────────────────────
AUTH_ACCESS_TOKEN_JWT_SECRET=dev-access-secret-change-in-prod
AUTH_ACCESS_TOKEN_JWT_EXPIRES_IN=15m
AUTH_REFRESH_TOKEN_JWT_SECRET=dev-refresh-secret-change-in-prod
AUTH_REFRESH_TOKEN_JWT_EXPIRES_IN=7d

# ── OAuth — Google ────────────────────────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# ── OAuth — GitHub ────────────────────────────────────────────────────────────
# https://github.com/settings/developers → OAuth Apps
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# ── OAuth — Microsoft ─────────────────────────────────────────────────────────
# https://portal.azure.com → App registrations
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=

# ── Stockage ──────────────────────────────────────────────────────────────────
# Option 1 — Local (zéro config, fichiers dans ./uploads)
STORAGE_DRIVER=local
STORAGE_UPLOAD_DIR=./uploads

# Option 2 — MinIO via docker-compose.dev.yml (make services)
# Créer le bucket "genie" dans la console MinIO → http://localhost:9001
# STORAGE_DRIVER=minio
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_BUCKET=genie
# STORAGE_ACCESS_ID=minioadmin
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_PUBLIC_URL=http://localhost:9000/genie

# Option 3 — Cloudflare R2
# STORAGE_DRIVER=r2
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_BUCKET=le-genie
# STORAGE_ACCESS_ID=<r2-access-key-id>
# STORAGE_ACCESS_KEY=<r2-secret-access-key>
# STORAGE_PUBLIC_URL=https://pub-<hash>.r2.dev

# Option 4 — AWS S3
# STORAGE_DRIVER=s3
# STORAGE_REGION=eu-west-1
# STORAGE_BUCKET=le-genie
# STORAGE_ACCESS_ID=<aws-access-key>
# STORAGE_ACCESS_KEY=<aws-secret-key>

# ── Email ─────────────────────────────────────────────────────────────────────
# Option 1 — Mailhog (dev) via docker-compose.dev.yml (make services)
# Visualiser les emails → http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_DEFAULT_EMAIL=noreply@legenie.local
MAIL_DEFAULT_NAME=Le Génie
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false

# Option 2 — SMTP classique (Gmail, Brevo, Resend…)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=your@gmail.com
# MAIL_PASSWORD=app-password
# MAIL_DEFAULT_EMAIL=noreply@legenie.fr
# MAIL_DEFAULT_NAME=Le Génie
# MAIL_IGNORE_TLS=false
# MAIL_SECURE=false
# MAIL_REQUIRE_TLS=true
